{
  "name": "linkedin-browser-mcp",
  "version": "0.9.3",
  "description": "LinkedIn automation as an MCP server over stdio. Drives your installed Chrome \u2014 no separate app, no browser download.",
  "author": "Mehmood Ur Rehman Qureshi",
  "license": "MIT",
  "homepage": "https://github.com/Mehmoodqureshi/linkedin-browser-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mehmoodqureshi/linkedin-browser-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Mehmoodqureshi/linkedin-browser-mcp/issues"
  },
  "main": "dist/cli.js",
  "bin": {
    "linkedin-browser-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linkedin",
    "playwright",
    "automation",
    "claude"
  ],
  "scripts": {
    "mcp": "node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:hitl": "ts-node --project tsconfig.json test/hitl/index.ts",
    "test:hitl:all": "ts-node --project tsconfig.json test/hitl/index.ts --include-mutating",
    "test:unit": "ts-node --project tsconfig.json test/mutation-gate.test.ts && ts-node --project tsconfig.json test/quota.test.ts && ts-node --project tsconfig.json test/tools-catalog.test.ts && ts-node --project tsconfig.json test/tool-surface.test.ts && ts-node --project tsconfig.json test/connections-parse.test.ts",
    "gen-icon": "node scripts/gen-icon.js",
    "pack:mcpb": "node scripts/pack-mcpb.js",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.49.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
